{% extends 'perfetti/layout.html.twig' %}

{% block content %}
    <div class="wrap">
        <div>
            <h1>Notre plateforme arrive en janvier.</h1>
            <p class="lead">Encore un peu de patience&nbsp;! Vos offres de remboursement arrivent bientôt !</p>

            <p class="sections-label">Mais également la présentation de l'ensemble de nos produits :</p>
            <div class="sections" aria-label="Rubriques à venir">
                <span>Nos gums</span>
                <span>Nos bonbons et sucettes</span>
                <span>Nos présentoirs</span>
            </div>
        </div>

        <div class="visual" aria-hidden="true">
            <div class="bubble">
                <div class="month">
                    <small>Rendez-vous en</small>
                    <strong>janvier</strong>
                </div>
            </div>
            <div class="dot"></div>
        </div>
    </div>
{% endblock %}
